# The Vercel project is now a redirect stub only (see vercel.json) — the site
# is served from Cloudflare Pages out of dist/. Nothing here should ever be
# published, but `vercel --prod` uploads the working tree, so keep the list
# accurate in case the stub is ever redeployed.

# Local working copies. The site reads the parquet and static.json from R2.
data/

# Tests, and the Cloudflare Pages build output.
tests/
dist/

# R2 bucket CORS policy — infrastructure config applied with
# `wrangler r2 bucket cors set`. Nothing serves it.
r2-cors.json

.wrangler/
node_modules/
